<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Clinic Management System</a>
                <div class="navbar-nav">
                    <a class="nav-link text-white" asp-page="/Doctors/Index">Doctors</a>
                    <a class="nav-link text-white" asp-page="/Patients/Index">Patients</a>
                    <a class="nav-link text-white" asp-page="/Appointments/Index">Appointments</a>
                    <a class="nav-link text-white" asp-page="/Departments/Index">Departments</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
