@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.StaffMembers.DetailsModel
@if (Model.StaffMember is not null)
{
<h1>@Model.StaffMember.Name</h1>
<dl class="row"><dt class="col-sm-3">Designation</dt><dd class="col-sm-9">@Model.StaffMember.Designation</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.StaffMember.PhoneNumber</dd><dt class="col-sm-3">Qualification</dt><dd class="col-sm-9">@Model.StaffMember.Qualification</dd></dl>
}
