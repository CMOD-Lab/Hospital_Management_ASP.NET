@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.StaffMembers.EditModel
<h1>Edit Staff Member</h1>
<form method="post" class="row g-3"><input asp-for="Input.Id" type="hidden" /><div class="col-md-6"><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /></div><div class="col-md-6"><label asp-for="Input.PhoneNumber"></label><input asp-for="Input.PhoneNumber" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Gender"></label><input asp-for="Input.Gender" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Designation"></label><input asp-for="Input.Designation" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.Salary"></label><input asp-for="Input.Salary" class="form-control" /></div><div class="col-12"><label asp-for="Input.Address"></label><input asp-for="Input.Address" class="form-control" /></div><div class="col-12 form-check"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label"></label></div><div class="col-12"><button class="btn btn-primary">Save</button></div></form>
