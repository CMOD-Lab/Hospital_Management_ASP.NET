@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.Appointments.EditModel
<h1>Edit Appointment</h1>
<form method="post" class="row g-3"><input asp-for="Input.Id" type="hidden" /><div class="col-md-3"><label asp-for="Input.PatientId"></label><input asp-for="Input.PatientId" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.DoctorId"></label><input asp-for="Input.DoctorId" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.ScheduledAt"></label><input asp-for="Input.ScheduledAt" class="form-control" /></div><div class="col-md-3"><label asp-for="Input.Status"></label><input asp-for="Input.Status" class="form-control" /></div><div class="col-12"><label asp-for="Input.Notes"></label><textarea asp-for="Input.Notes" class="form-control"></textarea></div><div class="col-12 form-check"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label"></label></div><div class="col-12"><button class="btn btn-primary">Save</button></div></form>
