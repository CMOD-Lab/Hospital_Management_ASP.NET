@page
@model ClinicManagementSystem.Web.Pages.Appointments.IndexModel
<h1>Appointments</h1>
<p><a class="btn btn-primary" asp-page="Create">Create Appointment</a></p>
<table class="table table-striped"><thead><tr><th>Name</th><th>Status</th><th>Scheduled</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items){<tr><td>@item.Name</td><td>@item.Status</td><td>@item.ScheduledAt</td><td><a asp-page="Details" asp-route-id="@item.Id">Details</a> <a asp-page="Edit" asp-route-id="@item.Id">Edit</a> <a asp-page="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>
