@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.Appointments.DetailsModel
<h1>Appointment Details</h1>
@if (Model.Item is null){<p>Appointment not found.</p>} else {<dl class="row"><dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Item.Name</dd><dt class="col-sm-2">Status</dt><dd class="col-sm-10">@Model.Item.Status</dd></dl>}
