@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.Departments.DetailsModel
<h1>Department Details</h1>
@if (Model.Item is null){<p>Department not found.</p>} else {<dl class="row"><dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Item.Name</dd><dt class="col-sm-2">Description</dt><dd class="col-sm-10">@Model.Item.Description</dd></dl>}
