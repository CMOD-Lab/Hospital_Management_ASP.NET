@page
@model ClinicManagementSystem.Web.Pages.Departments.CreateModel
<h1>Create Department</h1>
<form method="post" class="row g-3">
    <div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Description" class="form-label"></label><input asp-for="Input.Description" class="form-control" /></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Save</button></div>
</form>
