@page
@model ClinicManagementSystem.Web.Pages.Patients.CreateModel
<h1>Create Patient</h1>
<form method="post" class="row g-3">
<div class="col-md-6"><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /></div>
<div class="col-md-6"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Input.PhoneNumber"></label><input asp-for="Input.PhoneNumber" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Input.Gender"></label><input asp-for="Input.Gender" class="form-control" /></div>
<div class="col-md-4"><label asp-for="Input.BirthDate"></label><input asp-for="Input.BirthDate" class="form-control" /></div>
<div class="col-12"><label asp-for="Input.Address"></label><input asp-for="Input.Address" class="form-control" /></div>
<div class="col-12"><button class="btn btn-success">Save</button></div>
</form>
