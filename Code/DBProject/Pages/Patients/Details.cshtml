@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.Patients.DetailsModel
<h1>Patient Details</h1>
@if (Model.Item is null){<p>Patient not found.</p>} else {<dl class="row"><dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.Item.Name</dd><dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Item.Email</dd></dl>}
