@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.Doctors.EditModel
@{
    ViewData["Title"] = "Edit Doctor";
}
<h1>Edit Doctor</h1>
<form method="post" class="row g-3">
    <input asp-for="Input.Id" type="hidden" />
    <div class="col-md-6"><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.PhoneNumber"></label><input asp-for="Input.PhoneNumber" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Specialization"></label><input asp-for="Input.Specialization" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Input.Qualification"></label><input asp-for="Input.Qualification" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Input.YearsOfExperience"></label><input asp-for="Input.YearsOfExperience" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Input.ChargesPerVisit"></label><input asp-for="Input.ChargesPerVisit" class="form-control" /></div>
    <div class="col-12 form-check"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label"></label></div>
    <div class="col-12"><button class="btn btn-primary">Save</button></div>
</form>
