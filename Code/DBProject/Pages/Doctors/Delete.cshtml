@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.Doctors.DeleteModel
@{
    ViewData["Title"] = "Delete Doctor";
}
<h1>Delete Doctor</h1>
@if (Model.Doctor is not null)
{
    <p>Are you sure you want to delete <strong>@Model.Doctor.Name</strong>?</p>
    <form method="post">
        <button class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
