@page "{id:int}"
@model ClinicManagementSystem.Web.Pages.Doctors.DeleteModel
<h1>Delete Doctor</h1>
@if (Model.Item is not null)
{
    <p>Are you sure you want to delete <strong>@Model.Item.Name</strong>?</p>
    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
