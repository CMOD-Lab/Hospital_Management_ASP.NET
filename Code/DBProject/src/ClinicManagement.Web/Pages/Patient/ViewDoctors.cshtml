@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/PatientHome">Home</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/TakeAppointment">Take Appointment</a></li>
}

<h2><i class="bi bi-person-badge"></i> View Doctors</h2>
<hr />

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <select name="deptName" class="form-select" onchange="this.form.submit()">
                <option value="">All Departments</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept.DeptName" selected="@(Model.SelectedDepartment == dept.DeptName)">
                        @dept.DeptName
                    </option>
                }
            </select>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Name</th><th>Department</th><th>Specialization</th><th>Charges/Visit</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model.Doctors)
        {
            <tr>
                <td>@doctor.Name</td>
                <td>@doctor.DepartmentName</td>
                <td>@doctor.Specialization</td>
                <td>@doctor.ChargesPerVisit.ToString("C")</td>
                <td>
                    <a asp-page="/Patient/DoctorProfile"
                       asp-route-doctorId="@doctor.DoctorId"
                       class="btn btn-info btn-sm">
                        <i class="bi bi-eye"></i> Profile
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
