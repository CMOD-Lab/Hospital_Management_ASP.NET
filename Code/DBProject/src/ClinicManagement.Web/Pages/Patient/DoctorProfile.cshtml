@page "{doctorId:int}"
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/PatientHome">Home</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/ViewDoctors">Back to Doctors</a></li>
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4><i class="bi bi-person-badge"></i> Dr. @Model.Profile.Name</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Phone:</strong> @Model.Profile.Phone</p>
                        <p><strong>Gender:</strong> @Model.Profile.Gender</p>
                        <p><strong>Age:</strong> @Model.Profile.Age years</p>
                        <p><strong>Work Experience:</strong> @Model.Profile.WorkExperience years</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Charges/Visit:</strong> @Model.Profile.ChargesPerVisit.ToString("C")</p>
                        <p><strong>Repute Index:</strong> @Model.Profile.ReputeIndex.ToString("F2")</p>
                        <p><strong>Patients Treated:</strong> @Model.Profile.PatientsTreated</p>
                    </div>
                </div>
                <hr />
                <p><strong>Qualification:</strong> @Model.Profile.Qualification</p>
                <p><strong>Specialization:</strong> @Model.Profile.Specialization</p>
                <div class="mt-3">
                    <a asp-page="/Patient/TakeAppointment"
                       asp-route-doctorId="@Model.Profile.DoctorId"
                       class="btn btn-success">
                        <i class="bi bi-calendar-plus"></i> Book Appointment
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
