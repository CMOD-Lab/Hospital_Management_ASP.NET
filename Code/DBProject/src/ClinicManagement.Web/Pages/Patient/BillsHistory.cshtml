@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/PatientHome">Home</a></li>
}

<h2><i class="bi bi-receipt"></i> Bills History</h2>
<hr />

@if (!Model.Bills.Any())
{
    <div class="alert alert-info">No bills found.</div>
}
else
{
    <table class="table table-striped">
        <thead class="table-dark">
            <tr><th>ID</th><th>Doctor</th><th>Date</th><th>Bill Status</th></tr>
        </thead>
        <tbody>
            @foreach (var bill in Model.Bills)
            {
                <tr>
                    <td>@bill.AppointmentId</td>
                    <td>@bill.DoctorName</td>
                    <td>@bill.AppointmentDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                            @bill.BillStatus
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
