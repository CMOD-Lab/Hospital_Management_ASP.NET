@page
@model ClinicManagement.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/PatientHome">Home</a></li>
}

<h2><i class="bi bi-bell"></i> Notifications</h2>
<hr />

@if (Model.NotificationInfo.HasNotification)
{
    <div class="alert alert-success">
        <h5><i class="bi bi-check-circle"></i> Appointment Approved!</h5>
        <p><strong>Doctor:</strong> @Model.NotificationInfo.DoctorName</p>
        <p><strong>Timings:</strong> @Model.NotificationInfo.Timings</p>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No new notifications.
    </div>
}
