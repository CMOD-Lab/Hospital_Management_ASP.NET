@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/PatientHome">Home</a></li>
}

<h2><i class="bi bi-star"></i> Patient Feedback</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.FeedbackInfo.Message))
{
    <div class="alert alert-success">@Model.FeedbackInfo.Message</div>
}

@if (Model.FeedbackInfo.HasPendingFeedback)
{
    <div class="card">
        <div class="card-header bg-warning">
            <h5>Pending Feedback</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.FeedbackInfo.DoctorName</p>
            <p><strong>Appointment:</strong> @Model.FeedbackInfo.Timings</p>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.FeedbackInfo.AppointmentId" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-star-fill"></i> Submit Feedback
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No pending feedback.
    </div>
}
