@page
@model ClinicManagement.Web.Pages.Patient.CurrentAppointmentModel
@{
    ViewData["Title"] = "Current Appointment";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Patient/PatientHome">Home</a></li>
}

<h2><i class="bi bi-calendar-check"></i> Current Appointment</h2>
<hr />

@if (Model.AppointmentInfo.HasAppointment)
{
    <div class="card">
        <div class="card-header bg-success text-white">
            <h5>Today's Appointment</h5>
        </div>
        <div class="card-body">
            <p><strong>Doctor:</strong> @Model.AppointmentInfo.DoctorName</p>
            <p><strong>Timings:</strong> @Model.AppointmentInfo.Timings</p>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> You have no appointment scheduled for today.
    </div>
}
