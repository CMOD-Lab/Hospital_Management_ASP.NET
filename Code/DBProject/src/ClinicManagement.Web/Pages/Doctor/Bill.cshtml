@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Generate Bills";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Doctor/DoctorHome">Home</a></li>
}

<h2><i class="bi bi-receipt"></i> Generate Bills</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

@if (!Model.Appointments.Any())
{
    <div class="alert alert-info">No appointments to bill.</div>
}
else
{
    <table class="table table-striped">
        <thead class="table-dark">
            <tr><th>ID</th><th>Patient</th><th>Date</th><th>Bill Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var appt in Model.Appointments)
            {
                <tr>
                    <td>@appt.AppointmentId</td>
                    <td>@appt.PatientName</td>
                    <td>@appt.AppointmentDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge @(appt.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                            @appt.BillStatus
                        </span>
                    </td>
                    <td>
                        <form method="post" asp-page-handler="MarkPaid" style="display:inline">
                            <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                            <button type="submit" class="btn btn-success btn-sm">Paid</button>
                        </form>
                        <form method="post" asp-page-handler="MarkUnpaid" style="display:inline">
                            <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                            <button type="submit" class="btn btn-warning btn-sm">Unpaid</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
