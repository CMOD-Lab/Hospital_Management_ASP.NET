@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Doctor/DoctorHome">Home</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Doctor/PatientHistory">Today's Patients</a></li>
}

<h2><i class="bi bi-clock-history"></i> Pending Appointments</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

@if (!Model.Appointments.Any())
{
    <div class="alert alert-info">No pending appointments.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th><th>Patient</th><th>Date</th><th>Timings</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appt in Model.Appointments)
            {
                <tr>
                    <td>@appt.AppointmentId</td>
                    <td>@appt.PatientName</td>
                    <td>@appt.AppointmentDate?.ToString("yyyy-MM-dd")</td>
                    <td>@appt.Timings</td>
                    <td>
                        <form method="post" asp-page-handler="Approve" style="display:inline">
                            <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="bi bi-check"></i> Approve
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Reject" style="display:inline">
                            <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Reject this appointment?')">
                                <i class="bi bi-x"></i> Reject
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
