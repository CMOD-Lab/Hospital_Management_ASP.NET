@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Today's Patients";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Doctor/DoctorHome">Home</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Doctor/PendingAppointment">Pending</a></li>
}

<h2><i class="bi bi-people"></i> Today's Patients</h2>
<hr />

@if (!Model.Appointments.Any())
{
    <div class="alert alert-info">No appointments scheduled for today.</div>
}
else
{
    <table class="table table-striped">
        <thead class="table-dark">
            <tr><th>ID</th><th>Patient</th><th>Timings</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var appt in Model.Appointments)
            {
                <tr>
                    <td>@appt.AppointmentId</td>
                    <td>@appt.PatientName</td>
                    <td>@appt.Timings</td>
                    <td>
                        <a asp-page="/Doctor/HistoryUpdate"
                           asp-route-appointmentId="@appt.AppointmentId"
                           class="btn btn-primary btn-sm">
                            <i class="bi bi-pencil"></i> Update
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
