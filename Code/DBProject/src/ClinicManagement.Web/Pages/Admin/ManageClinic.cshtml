@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
}

@section NavItems {
    <li class="nav-item"><a class="nav-link" asp-page="/Admin/AdminHome">Dashboard</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Admin/DoctorRegistrationForm">Add Doctor</a></li>
    <li class="nav-item"><a class="nav-link" asp-page="/Admin/AddStaff">Add Staff</a></li>
}

<h2><i class="bi bi-building"></i> Manage Clinic</h2>
<hr />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search doctors or staff..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<ul class="nav nav-tabs mb-3" id="clinicTabs">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#doctors">Doctors</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#staff">Staff</a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="doctors">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th><th>Name</th><th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model.Doctors)
                {
                    <tr>
                        <td>@doctor.DoctorId</td>
                        <td>@doctor.Name</td>
                        <td>@doctor.DepartmentName</td>
                        <td>
                            <form method="post" asp-page-handler="DeleteDoctor" style="display:inline">
                                <input type="hidden" name="doctorId" value="@doctor.DoctorId" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this doctor?')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="tab-pane fade" id="staff">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th><th>Name</th><th>Designation</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model.Staff)
                {
                    <tr>
                        <td>@staff.StaffId</td>
                        <td>@staff.Name</td>
                        <td>@staff.Designation</td>
                        <td>
                            <form method="post" asp-page-handler="DeleteStaff" style="display:inline">
                                <input type="hidden" name="staffId" value="@staff.StaffId" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this staff member?')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
