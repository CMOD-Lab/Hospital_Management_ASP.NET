@page
@model ClinicManagement.Web.Pages.Admin.DoctorRegistrationFormModel
@{
    ViewData["Title"] = "Register Doctor";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4><i class="fas fa-user-md me-2"></i>Doctor Registration Form</h4>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }

                <form method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name *</label>
                            <input type="text" class="form-control" name="Name" required maxlength="30" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address *</label>
                            <input type="email" class="form-control" name="Email" required maxlength="30" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Password *</label>
                            <input type="password" class="form-control" name="Password" required maxlength="30" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date of Birth *</label>
                            <input type="date" class="form-control" name="BirthDate" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone Number *</label>
                            <input type="tel" class="form-control" name="Phone" required maxlength="15" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender *</label>
                            <select class="form-select" name="Gender" required>
                                <option value="">Select Gender</option>
                                <option value="M">Male</option>
                                <option value="F">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department *</label>
                            <select class="form-select" name="DeptNo" required>
                                <option value="">Select Department</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.DeptNo">@dept.DeptName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Address *</label>
                            <input type="text" class="form-control" name="Address" required maxlength="30" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Experience (years) *</label>
                            <input type="number" class="form-control" name="Experience" required min="0" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Salary *</label>
                            <input type="number" class="form-control" name="Salary" required min="0" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Charges Per Visit *</label>
                            <input type="number" class="form-control" name="ChargesPerVisit" required min="0" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Specialization *</label>
                            <input type="text" class="form-control" name="Specialization" required maxlength="30" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Qualification *</label>
                            <input type="text" class="form-control" name="Qualification" required maxlength="30" />
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-2"></i>Register Doctor
                        </button>
                        <a asp-page="/Admin/AdminHome" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
