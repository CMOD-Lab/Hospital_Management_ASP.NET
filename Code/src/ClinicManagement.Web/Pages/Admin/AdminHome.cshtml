@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
    <div>
        <a asp-page="/Admin/ManageClinic" class="btn btn-outline-primary me-2">
            <i class="fas fa-clinic-medical me-1"></i>Manage Clinic
        </a>
        <a asp-page="/Admin/DoctorRegistrationForm" class="btn btn-outline-success me-2">
            <i class="fas fa-user-md me-1"></i>Add Doctor
        </a>
        <a asp-page="/Admin/AddStaff" class="btn btn-outline-info">
            <i class="fas fa-user-nurse me-1"></i>Add Staff
        </a>
    </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Doctors</h6>
                        <h2>@Model.TotalDoctors</h2>
                    </div>
                    <i class="fas fa-user-md fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Patients</h6>
                        <h2>@Model.TotalPatients</h2>
                    </div>
                    <i class="fas fa-procedures fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Total Income</h6>
                        <h2>$@Model.TotalIncome.ToString("N0")</h2>
                    </div>
                    <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Departments Table -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-building me-2"></i>Departments</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Department Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.Departments)
                            {
                                <tr>
                                    <td>@dept.DeptNo</td>
                                    <td>@dept.DeptName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointments Table -->
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Recent Appointments</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Doctor</th>
                                <th>Patient</th>
                                <th>Timings</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.Appointments)
                            {
                                <tr>
                                    <td>@appt.DoctorName</td>
                                    <td>@appt.PatientName</td>
                                    <td>@appt.Timings</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
