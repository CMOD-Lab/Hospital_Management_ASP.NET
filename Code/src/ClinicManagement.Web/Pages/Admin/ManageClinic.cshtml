@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-clinic-medical me-2"></i>Manage Clinic</h2>
    <a asp-page="/Admin/AdminHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<!-- Doctors Section -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Doctors</h5>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" class="form-control" name="doctorSearch" value="@Model.DoctorSearch" placeholder="Search doctors..." />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <tr>
                            <td>@doctor.DoctorId</td>
                            <td>@doctor.Name</td>
                            <td>@doctor.DeptName</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteDoctor" style="display:inline;">
                                    <input type="hidden" name="doctorId" value="@doctor.DoctorId" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to remove this doctor?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Patients Section -->
<div class="card shadow mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-procedures me-2"></i>Patients</h5>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" class="form-control" name="patientSearch" value="@Model.PatientSearch" placeholder="Search patients..." />
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.Patients)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.Name</td>
                            <td>@patient.Phone</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Staff Section -->
<div class="card shadow">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fas fa-user-nurse me-2"></i>Other Staff</h5>
    </div>
    <div class="card-body">
        <form method="get" class="mb-3">
            <div class="input-group">
                <input type="text" class="form-control" name="staffSearch" value="@Model.StaffSearch" placeholder="Search staff..." />
                <button type="submit" class="btn btn-info text-white">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.StaffList)
                    {
                        <tr>
                            <td>@staff.StaffId</td>
                            <td>@staff.Name</td>
                            <td>@staff.Designation</td>
                            <td>
                                <form method="post" asp-page-handler="DeleteStaff" style="display:inline;">
                                    <input type="hidden" name="staffId" value="@staff.StaffId" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to remove this staff member?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
