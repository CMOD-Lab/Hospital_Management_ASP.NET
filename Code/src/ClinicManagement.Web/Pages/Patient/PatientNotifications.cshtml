@page
@model ClinicManagement.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-bell me-2"></i>Notifications</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Notifications.Any())
        {
            @foreach (var notification in Model.Notifications)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Appointment Approved!</strong><br />
                    Doctor: @notification.DoctorName<br />
                    Timings: @notification.Timings
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No new notifications.
            </div>
        }
    </div>
</div>
