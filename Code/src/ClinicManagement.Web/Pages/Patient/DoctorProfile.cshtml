@page "{id:int}"
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>
    <a asp-page="/Patient/ViewDoctors" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

@if (Model.Doctor != null)
{
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Model.Doctor.Name</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr><th>Phone:</th><td>@Model.Doctor.Phone</td></tr>
                        <tr><th>Gender:</th><td>@(Model.Doctor.Gender == "M" ? "Male" : "Female")</td></tr>
                        <tr><th>Department:</th><td>@Model.Doctor.DeptName</td></tr>
                        <tr><th>Specialization:</th><td>@Model.Doctor.Specialization</td></tr>
                        <tr><th>Qualification:</th><td>@Model.Doctor.Qualification</td></tr>
                        <tr><th>Experience:</th><td>@Model.Doctor.Experience years</td></tr>
                        <tr><th>Charges/Visit:</th><td>$@Model.Doctor.ChargesPerVisit</td></tr>
                        <tr><th>Repute Index:</th><td>@Model.Doctor.ReputeIndex.ToString("F2")</td></tr>
                        <tr><th>Patients Treated:</th><td>@Model.Doctor.PatientsTreated</td></tr>
                    </table>
                    <a asp-page="/Patient/TakeAppointment" asp-route-doctorId="@Model.Doctor.DoctorId" class="btn btn-success">
                        <i class="fas fa-calendar-plus me-2"></i>Book Appointment
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Doctor not found.</div>
}
