@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-notes-medical me-2"></i>Treatment History</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.History.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-info">
                        <tr>
                            <th>#</th>
                            <th>Doctor</th>
                            <th>Timings</th>
                            <th>Disease</th>
                            <th>Progress</th>
                            <th>Prescription</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int i = 1;}
                        @foreach (var record in Model.History)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>@record.DoctorName</td>
                                <td>@record.Timings</td>
                                <td>@(record.Disease ?? "-")</td>
                                <td>@(record.Progress ?? "-")</td>
                                <td>@(record.Prescription ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No treatment history found.
            </div>
        }
    </div>
</div>
