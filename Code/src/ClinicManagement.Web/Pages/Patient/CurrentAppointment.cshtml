@page
@model ClinicManagement.Web.Pages.Patient.CurrentAppointmentModel
@{
    ViewData["Title"] = "Current Appointment";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-day me-2"></i>Current Appointment</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.HasAppointment)
        {
            <div class="alert alert-success">
                <h5><i class="fas fa-calendar-check me-2"></i>Active Appointment</h5>
                <p><strong>Doctor:</strong> @Model.DoctorName</p>
                <p><strong>Timings:</strong> @Model.Timings</p>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>You have no current appointment.
            </div>
        }
    </div>
</div>
