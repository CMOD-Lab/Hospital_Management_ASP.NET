@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-invoice-dollar me-2"></i>Bills History</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Bills.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-warning">
                        <tr>
                            <th>#</th>
                            <th>Doctor</th>
                            <th>Timings</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int i = 1;}
                        @foreach (var bill in Model.Bills)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>@bill.DoctorName</td>
                                <td>@bill.Timings</td>
                                <td>$@bill.Amount.ToString("N2")</td>
                                <td>
                                    @if (bill.IsPaid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Unpaid</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No billing history found.
            </div>
        }
    </div>
</div>
