@page
@model ClinicManagement.Web.Pages.Patient.TakeAppointmentModel
@{
    ViewData["Title"] = "Take Appointment";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-calendar-plus me-2"></i>Take Appointment</h2>
    <a asp-page="/Patient/PatientHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<!-- Step 1: Select Department -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Step 1: Select Department</h5>
    </div>
    <div class="card-body">
        <form method="get">
            <div class="row align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Department</label>
                    <select class="form-select" name="deptName">
                        <option value="">Select Department</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.DeptName" selected="@(Model.SelectedDept == dept.DeptName)">@dept.DeptName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i>Find Doctors
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Step 2: Select Doctor -->
@if (Model.DeptDoctors.Any())
{
    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Step 2: Select Doctor</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Charges/Visit</th>
                            <th>Repute Index</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doctor in Model.DeptDoctors)
                        {
                            <tr>
                                <td>@doctor.DoctorId</td>
                                <td>@doctor.Name</td>
                                <td>$@doctor.ChargesPerVisit</td>
                                <td>@doctor.ReputeIndex.ToString("F2")</td>
                                <td>
                                    <a asp-page="/Patient/AppointmentTaker" asp-route-doctorId="@doctor.DoctorId" class="btn btn-sm btn-success">
                                        <i class="fas fa-calendar-check me-1"></i>Book
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
