@page
@model ClinicManagement.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Home";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-md me-2"></i>Welcome, Dr. @Model.DoctorName!</h2>
</div>

<!-- Doctor Info Card -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-id-card me-2"></i>My Profile</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr><th>Name:</th><td>Dr. @Model.DoctorName</td></tr>
                    <tr><th>Phone:</th><td>@Model.Phone</td></tr>
                    <tr><th>Department:</th><td>@Model.DeptName</td></tr>
                    <tr><th>Specialization:</th><td>@Model.Specialization</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Navigation Cards -->
<div class="row">
    <div class="col-md-3 mb-3">
        <a asp-page="/Doctor/PendingAppointment" class="text-decoration-none">
            <div class="card shadow text-center p-3 h-100 border-warning">
                <i class="fas fa-clock fa-3x text-warning mb-2"></i>
                <h6>Pending Appointments</h6>
            </div>
        </a>
    </div>
    <div class="col-md-3 mb-3">
        <a asp-page="/Doctor/PatientHistory" class="text-decoration-none">
            <div class="card shadow text-center p-3 h-100 border-info">
                <i class="fas fa-history fa-3x text-info mb-2"></i>
                <h6>Patient History</h6>
            </div>
        </a>
    </div>
    <div class="col-md-3 mb-3">
        <a asp-page="/Doctor/HistoryUpdate" class="text-decoration-none">
            <div class="card shadow text-center p-3 h-100 border-success">
                <i class="fas fa-edit fa-3x text-success mb-2"></i>
                <h6>Update History</h6>
            </div>
        </a>
    </div>
    <div class="col-md-3 mb-3">
        <a asp-page="/Doctor/Bill" class="text-decoration-none">
            <div class="card shadow text-center p-3 h-100 border-danger">
                <i class="fas fa-file-invoice-dollar fa-3x text-danger mb-2"></i>
                <h6>Generate Bills</h6>
            </div>
        </a>
    </div>
    <div class="col-md-3 mb-3">
        <a asp-page="/Doctor/PreviousHistory" class="text-decoration-none">
            <div class="card shadow text-center p-3 h-100 border-secondary">
                <i class="fas fa-archive fa-3x text-secondary mb-2"></i>
                <h6>Previous History</h6>
            </div>
        </a>
    </div>
</div>
