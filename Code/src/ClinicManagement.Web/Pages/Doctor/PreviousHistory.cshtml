@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-archive me-2"></i>Previous Patient History</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.History.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-secondary">
                        <tr>
                            <th>Appointment ID</th>
                            <th>Patient Name</th>
                            <th>Timings</th>
                            <th>Disease</th>
                            <th>Progress</th>
                            <th>Prescription</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.History)
                        {
                            <tr>
                                <td>@record.AppointmentId</td>
                                <td>@record.PatientName</td>
                                <td>@record.Timings</td>
                                <td>@(record.Disease ?? "-")</td>
                                <td>@(record.Progress ?? "-")</td>
                                <td>@(record.Prescription ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No previous history found.
            </div>
        }
    </div>
</div>
