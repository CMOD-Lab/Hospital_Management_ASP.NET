@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Generate Bills";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-invoice-dollar me-2"></i>Generate Bills</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.Bills.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-danger">
                        <tr>
                            <th>Appointment ID</th>
                            <th>Patient</th>
                            <th>Timings</th>
                            <th>Amount</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in Model.Bills)
                        {
                            <tr>
                                <td>@bill.AppointmentId</td>
                                <td>@bill.DoctorName</td>
                                <td>@bill.Timings</td>
                                <td>$@bill.Amount.ToString("N2")</td>
                                <td>
                                    <form method="post" asp-page-handler="Paid" style="display:inline;">
                                        <input type="hidden" name="appointmentId" value="@bill.AppointmentId" />
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            <i class="fas fa-check me-1"></i>Paid
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Unpaid" style="display:inline;">
                                        <input type="hidden" name="appointmentId" value="@bill.AppointmentId" />
                                        <button type="submit" class="btn btn-sm btn-warning">
                                            <i class="fas fa-times me-1"></i>Unpaid
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No bills to generate.
            </div>
        }
    </div>
</div>
