@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-clock me-2"></i>Pending Appointments</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.Appointments.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-warning">
                        <tr>
                            <th>Appointment ID</th>
                            <th>Patient Name</th>
                            <th>Timings</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr>
                                <td>@appt.AppointmentId</td>
                                <td>@appt.PatientName</td>
                                <td>@appt.Timings</td>
                                <td>
                                    <form method="post" asp-page-handler="Approve" style="display:inline;">
                                        <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            <i class="fas fa-check me-1"></i>Approve
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject" style="display:inline;">
                                        <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Reject this appointment?')">
                                            <i class="fas fa-times me-1"></i>Reject
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No pending appointments.
            </div>
        }
    </div>
</div>
