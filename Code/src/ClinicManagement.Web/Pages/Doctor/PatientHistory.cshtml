@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Patient History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-history me-2"></i>Today's Appointments</h2>
    <a asp-page="/Doctor/DoctorHome" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Appointments.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-info">
                        <tr>
                            <th>Appointment ID</th>
                            <th>Patient Name</th>
                            <th>Timings</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr>
                                <td>@appt.AppointmentId</td>
                                <td>@appt.PatientName</td>
                                <td>@appt.Timings</td>
                                <td>
                                    <a asp-page="/Doctor/HistoryUpdate" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-sm btn-primary">
                                        <i class="fas fa-edit me-1"></i>Update
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No appointments for today.
            </div>
        }
    </div>
</div>
