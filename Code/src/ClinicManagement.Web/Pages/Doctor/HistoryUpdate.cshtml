@page "{appointmentId:int?}"
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-edit me-2"></i>Update Patient History</h2>
    <a asp-page="/Doctor/PatientHistory" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
            <div class="mb-3">
                <label class="form-label">Disease / Diagnosis</label>
                <input type="text" class="form-control" name="disease" maxlength="30" placeholder="Enter disease/diagnosis" />
            </div>
            <div class="mb-3">
                <label class="form-label">Progress</label>
                <textarea class="form-control" name="progress" rows="3" maxlength="50" placeholder="Enter patient progress"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Prescription</label>
                <textarea class="form-control" name="prescription" rows="3" maxlength="60" placeholder="Enter prescription"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Update
            </button>
        </form>
    </div>
</div>
