@page
@model CareTrack.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-clock me-2"></i>Pending Appointments</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.PendingAppointments.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No pending appointments.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-warning">
                            <tr>
                                <th>Appointment ID</th>
                                <th>Patient Name</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.PendingAppointments)
                            {
                                <tr>
                                    <td>@appt.AppointId</td>
                                    <td>@(appt.Patient?.Name ?? "Unknown")</td>
                                    <td>@(appt.Date?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                                    <td>
                                        <form method="post" asp-page-handler="Approve" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                            <button type="submit" class="btn btn-sm btn-success me-1">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Reject" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Reject this appointment?')">
                                                <i class="fas fa-times"></i> Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
