@page
@model CareTrack.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Home";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-stethoscope me-2"></i>Doctor Profile</h2>

    @if (Model.Doctor != null)
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow text-center">
                    <div class="card-body">
                        <i class="fas fa-user-md fa-5x text-success mb-3"></i>
                        <h4>@Model.Doctor.Name</h4>
                        <p class="text-muted">@Model.Doctor.Specialization</p>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Doctor Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Department:</strong> @(Model.Doctor.Department?.DeptName ?? "N/A")</p>
                                <p><strong>Phone:</strong> @(Model.Doctor.Phone ?? "N/A")</p>
                                <p><strong>Gender:</strong> @(Model.Doctor.Gender == "M" ? "Male" : "Female")</p>
                                <p><strong>Address:</strong> @(Model.Doctor.Address ?? "N/A")</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Qualification:</strong> @Model.Doctor.Qualification</p>
                                <p><strong>Work Experience:</strong> @(Model.Doctor.WorkExperience ?? 0) years</p>
                                <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
                                <p><strong>Patients Treated:</strong> @Model.Doctor.PatientsTreated</p>
                                <p><strong>Repute Index:</strong> @(Model.Doctor.ReputeIndex?.ToString("F2") ?? "N/A")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <a href="/Doctor/PendingAppointment" class="btn btn-warning w-100 mb-2">
                            <i class="fas fa-clock me-2"></i>Pending Appointments
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/Doctor/PatientHistory" class="btn btn-info w-100 mb-2">
                            <i class="fas fa-history me-2"></i>Patient History
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/Doctor/HistoryUpdate" class="btn btn-primary w-100 mb-2">
                            <i class="fas fa-edit me-2"></i>Update History
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/Doctor/Bill" class="btn btn-success w-100 mb-2">
                            <i class="fas fa-file-invoice-dollar me-2"></i>Billing
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>Error loading doctor information.
        </div>
    }
</div>
