@page
@model CareTrack.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Patient History";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-history me-2"></i>Patient History</h2>

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.PatientHistory.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No patient history found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Appointment ID</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Disease</th>
                                <th>Status</th>
                                <th>Bill</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.PatientHistory)
                            {
                                <tr>
                                    <td>@appt.AppointId</td>
                                    <td>@(appt.Patient?.Name ?? "Unknown")</td>
                                    <td>@(appt.Date?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    <td>@(appt.Disease ?? "N/A")</td>
                                    <td>
                                        <span class="badge @(appt.AppointmentStatus == 3 ? "bg-success" : appt.AppointmentStatus == 1 ? "bg-primary" : "bg-warning")">
                                            @(appt.AppointmentStatus switch { 1 => "Approved", 2 => "Pending", 3 => "Completed", 4 => "Rejected", _ => "Unknown" })
                                        </span>
                                    </td>
                                    <td>
                                        @if (appt.BillAmount.HasValue)
                                        {
                                            <span class="badge @(appt.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                                $@appt.BillAmount.Value.ToString("N2") - @appt.BillStatus
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
