@page
@model CareTrack.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Billing";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-file-invoice-dollar me-2"></i>Billing</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.BillableAppointments.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No billable appointments found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-success">
                            <tr>
                                <th>Appointment ID</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.BillableAppointments)
                            {
                                <tr>
                                    <td>@appt.AppointId</td>
                                    <td>@(appt.Patient?.Name ?? "Unknown")</td>
                                    <td>@(appt.Date?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    <td>@(appt.BillAmount.HasValue ? "$" + appt.BillAmount.Value.ToString("N2") : "N/A")</td>
                                    <td>
                                        <span class="badge @(appt.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                            @(appt.BillStatus ?? "Pending")
                                        </span>
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="MarkPaid" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                            <button type="submit" class="btn btn-sm btn-success me-1">
                                                <i class="fas fa-check"></i> Paid
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="MarkUnpaid" class="d-inline">
                                            <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                <i class="fas fa-times"></i> Unpaid
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
