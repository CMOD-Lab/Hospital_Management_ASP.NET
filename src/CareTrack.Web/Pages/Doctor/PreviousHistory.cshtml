@page
@model CareTrack.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-notes-medical me-2"></i>Previous Patient History</h2>

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.CompletedAppointments.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No completed appointments found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Patient</th>
                                <th>Date</th>
                                <th>Disease</th>
                                <th>Progress</th>
                                <th>Prescription</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.CompletedAppointments)
                            {
                                <tr>
                                    <td>@appt.AppointId</td>
                                    <td>@(appt.Patient?.Name ?? "Unknown")</td>
                                    <td>@(appt.Date?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    <td>@(appt.Disease ?? "N/A")</td>
                                    <td>@(appt.Progress ?? "N/A")</td>
                                    <td>@(appt.Prescription ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
