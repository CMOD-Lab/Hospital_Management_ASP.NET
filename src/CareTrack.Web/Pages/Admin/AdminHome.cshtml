@page
@model CareTrack.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Doctors</h6>
                            <h2 class="mb-0">@Model.TotalDoctors</h2>
                        </div>
                        <i class="fas fa-user-md fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Patients</h6>
                            <h2 class="mb-0">@Model.TotalPatients</h2>
                        </div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Income</h6>
                            <h2 class="mb-0">$@Model.TotalIncome.ToString("N2")</h2>
                        </div>
                        <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Department View -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-hospital me-2"></i>Departments</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th>Doctors</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.DepartmentStats)
                                {
                                    <tr>
                                        <td>@dept.DeptName</td>
                                        <td><span class="badge bg-primary">@dept.DoctorCount</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Appointments -->
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Recent Appointments</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.AppointmentStats)
                                {
                                    <tr>
                                        <td>@appt.PatientName</td>
                                        <td>@appt.DoctorName</td>
                                        <td>
                                            <span class="badge @(appt.Status == "Approved" ? "bg-success" : appt.Status == "Pending" ? "bg-warning" : appt.Status == "Completed" ? "bg-info" : "bg-danger")">
                                                @appt.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a href="/Admin/DoctorRegistrationForm" class="btn btn-primary me-2">
                        <i class="fas fa-user-md me-1"></i>Add Doctor
                    </a>
                    <a href="/Admin/AddStaff" class="btn btn-success me-2">
                        <i class="fas fa-user-plus me-1"></i>Add Staff
                    </a>
                    <a href="/Admin/ManageClinic" class="btn btn-info me-2">
                        <i class="fas fa-clinic-medical me-1"></i>Manage Clinic
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
