@page
@model CareTrack.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-bell me-2"></i>Notifications</h2>

    @if (Model.Notification != null)
    {
        <div class="card shadow border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Appointment Update</h5>
            </div>
            <div class="card-body">
                <p><strong>Doctor:</strong> @(Model.Notification.Doctor?.Name ?? "N/A")</p>
                <p><strong>Date/Time:</strong> @(Model.Notification.Date?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</p>
                <p><strong>Status:</strong>
                    <span class="badge bg-success">Approved</span>
                </p>
                <p class="text-success">Your appointment has been approved by the doctor!</p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No new notifications.
        </div>
    }
</div>
