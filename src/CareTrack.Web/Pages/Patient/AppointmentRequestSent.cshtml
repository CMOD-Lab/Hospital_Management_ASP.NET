@page
@model CareTrack.Web.Pages.Patient.AppointmentRequestSentModel
@{
    ViewData["Title"] = "Appointment Request Sent";
    Layout = "_PatientLayout";
}

<div class="container text-center mt-5">
    <div class="card shadow mx-auto" style="max-width: 500px;">
        <div class="card-body py-5">
            <i class="fas fa-check-circle fa-5x text-success mb-3"></i>
            <h3>Appointment Request Sent!</h3>
            <p class="text-muted">Your appointment request has been sent to the doctor. You will be notified once the doctor approves or rejects your request.</p>
            <div class="mt-4">
                <a href="/Patient/PatientHome" class="btn btn-primary me-2">
                    <i class="fas fa-home me-1"></i>Go Home
                </a>
                <a href="/Patient/PatientNotifications" class="btn btn-info">
                    <i class="fas fa-bell me-1"></i>View Notifications
                </a>
            </div>
        </div>
    </div>
</div>
