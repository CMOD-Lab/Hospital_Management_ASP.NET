@page
@model CareTrack.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-comment me-2"></i>Patient Feedback</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-info") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.PendingFeedback != null)
    {
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="fas fa-star me-2"></i>Pending Feedback</h5>
            </div>
            <div class="card-body">
                <p><strong>Doctor:</strong> @(Model.PendingFeedback.Doctor?.Name ?? "N/A")</p>
                <p><strong>Date:</strong> @(Model.PendingFeedback.Date?.ToString("yyyy-MM-dd") ?? "N/A")</p>
                <p>Please provide your feedback for this appointment.</p>

                <form method="post">
                    <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointId" />
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-thumbs-up me-2"></i>Submit Feedback
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No pending feedback.
        </div>
    }
</div>
