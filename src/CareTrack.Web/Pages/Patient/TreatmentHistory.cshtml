@page
@model CareTrack.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-notes-medical me-2"></i>Treatment History</h2>

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.TreatmentHistory.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No treatment history found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-info">
                            <tr>
                                <th>ID</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Disease</th>
                                <th>Progress</th>
                                <th>Prescription</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var treatment in Model.TreatmentHistory)
                            {
                                <tr>
                                    <td>@treatment.AppointId</td>
                                    <td>@(treatment.Doctor?.Name ?? "N/A")</td>
                                    <td>@(treatment.Date?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    <td>@(treatment.Disease ?? "N/A")</td>
                                    <td>@(treatment.Progress ?? "N/A")</td>
                                    <td>@(treatment.Prescription ?? "N/A")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
