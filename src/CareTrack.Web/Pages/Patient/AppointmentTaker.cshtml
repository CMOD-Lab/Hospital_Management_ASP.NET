@page
@model CareTrack.Web.Pages.Patient.AppointmentTakerModel
@{
    ViewData["Title"] = "Book Appointment";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-calendar-plus me-2"></i>Book Appointment</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Doctor != null)
    {
        <div class="card shadow mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Doctor: @Model.Doctor.Name</h5>
            </div>
            <div class="card-body">
                <p><strong>Department:</strong> @(Model.Doctor.Department?.DeptName ?? "N/A")</p>
                <p><strong>Charges/Visit:</strong> $@Model.Doctor.ChargesPerVisit</p>
            </div>
        </div>

        <form method="post">
            <input type="hidden" name="doctorId" value="@Model.DoctorId" />
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0">Request Appointment</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Click the button below to send an appointment request to the doctor. The doctor will review and approve or reject your request.</p>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-2"></i>Send Appointment Request
                    </button>
                    <a href="/Patient/ViewDoctors" class="btn btn-secondary ms-2">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>Doctor not found.
        </div>
    }
</div>
