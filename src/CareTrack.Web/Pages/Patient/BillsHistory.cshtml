@page
@model CareTrack.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-receipt me-2"></i>Bills History</h2>

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.BillHistory.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No bills found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-warning">
                            <tr>
                                <th>Appointment ID</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bill in Model.BillHistory)
                            {
                                <tr>
                                    <td>@bill.AppointId</td>
                                    <td>@(bill.Doctor?.Name ?? "N/A")</td>
                                    <td>@(bill.Date?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    <td>@(bill.BillAmount.HasValue ? "$" + bill.BillAmount.Value.ToString("N2") : "N/A")</td>
                                    <td>
                                        <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                            @(bill.BillStatus ?? "Pending")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
