@page
@model ClinicManagement.Web.Pages.Doctor.PatientHistoryModel
@{
    ViewData["Title"] = "Patient History";
    Layout = "_DoctorLayout";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-history me-2"></i>Patient History</h2>
        <hr />
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.HistoryModel.Records.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Disease</th>
                        <th>Prescription</th>
                        <th>Progress</th>
                        <th>Paid</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.HistoryModel.Records)
                    {
                        <tr>
                            <td>@record.AppointmentId</td>
                            <td>@record.PatientName</td>
                            <td>@record.Disease</td>
                            <td>@record.Prescription</td>
                            <td>@record.Progress</td>
                            <td>
                                @if (record.IsPaid)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">No</span>
                                }
                            </td>
                            <td>@record.AppointmentDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No patient history found.</div>
        }
    </div>
</div>
