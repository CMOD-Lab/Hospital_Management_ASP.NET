@page
@model ClinicManagement.Web.Pages.Doctor.DoctorHomeModel
@{
    ViewData["Title"] = "Doctor Home";
    Layout = "_DoctorLayout";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-stethoscope me-2"></i>Doctor Profile</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow text-center">
            <div class="card-body">
                <i class="fas fa-user-md fa-5x text-success mb-3"></i>
                <h4>@Model.DoctorInfo.Name</h4>
                <p class="text-muted">@Model.DoctorInfo.Specialization</p>
                <span class="badge bg-success">@Model.DoctorInfo.DepartmentName</span>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Doctor Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Email:</strong> @Model.DoctorInfo.Email</p>
                        <p><strong>Phone:</strong> @Model.DoctorInfo.Phone</p>
                        <p><strong>Gender:</strong> @Model.DoctorInfo.Gender</p>
                        <p><strong>Age:</strong> @Model.DoctorInfo.Age</p>
                        <p><strong>Experience:</strong> @Model.DoctorInfo.Experience years</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Qualification:</strong> @Model.DoctorInfo.Qualification</p>
                        <p><strong>Charges/Visit:</strong> $@Model.DoctorInfo.ChargesPerVisit</p>
                        <p><strong>Repute Index:</strong> @Model.DoctorInfo.ReputeIndex.ToString("F2")</p>
                        <p><strong>Patients Treated:</strong> @Model.DoctorInfo.PatientsTreated</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
