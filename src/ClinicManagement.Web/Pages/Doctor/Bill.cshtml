@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Bills";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-file-invoice-dollar me-2"></i>Bills</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (Model.Bills.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th><th>Patient</th><th>Date</th><th>Amount</th><th>Status</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bill in Model.Bills)
                            {
                                <tr>
                                    <td>@bill.AppointId</td>
                                    <td>@bill.PatientName</td>
                                    <td>@bill.Date?.ToString("MM/dd/yyyy")</td>
                                    <td>$@bill.BillAmount?.ToString("N2")</td>
                                    <td>
                                        <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                            @bill.BillStatus
                                        </span>
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="MarkPaid" style="display:inline;">
                                            <input type="hidden" name="appointmentId" value="@bill.AppointId" />
                                            <button type="submit" class="btn btn-success btn-sm me-1">
                                                <i class="fas fa-check me-1"></i>Paid
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="MarkUnpaid" style="display:inline;">
                                            <input type="hidden" name="appointmentId" value="@bill.AppointId" />
                                            <button type="submit" class="btn btn-warning btn-sm">
                                                <i class="fas fa-times me-1"></i>Unpaid
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No bills found.</div>
            }
        </div>
    </div>
</div>
