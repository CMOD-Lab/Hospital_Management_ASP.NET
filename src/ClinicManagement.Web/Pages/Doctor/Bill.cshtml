@page
@model ClinicManagement.Web.Pages.Doctor.BillModel
@{
    ViewData["Title"] = "Bills";
    Layout = "_DoctorLayout";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-file-invoice-dollar me-2"></i>Bills</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.BillViewModel.Message))
{
    <div class="alert alert-info">@Model.BillViewModel.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.BillViewModel.Bills.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Bill ID</th>
                        <th>Patient</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bill in Model.BillViewModel.Bills)
                    {
                        <tr>
                            <td>@bill.BillId</td>
                            <td>@bill.PatientName</td>
                            <td>$@bill.Amount.ToString("N2")</td>
                            <td>@bill.BillDate</td>
                            <td>
                                @if (bill.IsPaid)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Unpaid</span>
                                }
                            </td>
                            <td>
                                <form method="post" style="display:inline">
                                    <input type="hidden" name="appointmentId" value="@bill.BillId" />
                                    <button type="submit" asp-page-handler="Paid" class="btn btn-sm btn-success">
                                        <i class="fas fa-check"></i> Paid
                                    </button>
                                    <button type="submit" asp-page-handler="Unpaid" class="btn btn-sm btn-warning">
                                        <i class="fas fa-times"></i> Unpaid
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No bills found.</div>
        }
    </div>
</div>
