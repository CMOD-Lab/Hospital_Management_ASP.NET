@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-clock me-2"></i>Pending Appointments</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (Model.PendingAppointments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th><th>Patient</th><th>Date</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.PendingAppointments)
                            {
                                <tr>
                                    <td>@appt.AppointId</td>
                                    <td>@appt.PatientName</td>
                                    <td>@appt.Date?.ToString("MM/dd/yyyy HH:mm")</td>
                                    <td>
                                        <form method="post" asp-page-handler="Approve" style="display:inline;">
                                            <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                            <button type="submit" class="btn btn-success btn-sm me-1">
                                                <i class="fas fa-check me-1"></i>Approve
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Reject" style="display:inline;">
                                            <input type="hidden" name="appointmentId" value="@appt.AppointId" />
                                            <button type="submit" class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Reject this appointment?')">
                                                <i class="fas fa-times me-1"></i>Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No pending appointments.</div>
            }
        </div>
    </div>
</div>
