@page
@model ClinicManagement.Web.Pages.Doctor.PendingAppointmentModel
@{
    ViewData["Title"] = "Pending Appointments";
    Layout = "_DoctorLayout";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-calendar-check me-2"></i>Pending Appointments</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.PendingModel.Appointments.Any())
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Patient</th>
                        <th>Timings</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.PendingModel.Appointments)
                    {
                        <tr>
                            <td>@appt.AppointmentId</td>
                            <td>@appt.PatientName</td>
                            <td>@appt.Timings</td>
                            <td>@appt.AppointmentDate</td>
                            <td>
                                <form method="post" style="display:inline">
                                    <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                    <button type="submit" asp-page-handler="Approve" class="btn btn-sm btn-success">
                                        <i class="fas fa-check"></i> Approve
                                    </button>
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Delete this appointment?')">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No pending appointments found.</div>
        }
    </div>
</div>
