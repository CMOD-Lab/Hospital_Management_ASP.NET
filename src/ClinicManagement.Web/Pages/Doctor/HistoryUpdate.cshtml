@page
@model ClinicManagement.Web.Pages.Doctor.HistoryUpdateModel
@{
    ViewData["Title"] = "Update Prescription";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-edit me-2"></i>Update Prescription</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                <div class="mb-3">
                    <label for="disease" class="form-label">Disease</label>
                    <input type="text" class="form-control" id="disease" name="disease"
                           value="@Model.Disease" maxlength="100" />
                </div>
                <div class="mb-3">
                    <label for="progress" class="form-label">Progress</label>
                    <input type="text" class="form-control" id="progress" name="progress"
                           value="@Model.Progress" maxlength="100" />
                </div>
                <div class="mb-3">
                    <label for="prescription" class="form-label">Prescription</label>
                    <textarea class="form-control" id="prescription" name="prescription"
                              rows="3" maxlength="100">@Model.Prescription</textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Update
                    </button>
                    <a href="/Doctor/PatientHistory" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
