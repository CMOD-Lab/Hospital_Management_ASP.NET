@page
@model ClinicManagement.Web.Pages.Doctor.PreviousHistoryModel
@{
    ViewData["Title"] = "Previous History";
    Layout = "_DoctorLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-notes-medical me-2"></i>Previous Patient History</h2>
    <div class="card shadow">
        <div class="card-body">
            @if (Model.PatientHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th><th>Patient</th><th>Date</th><th>Disease</th><th>Progress</th><th>Prescription</th><th>Bill</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.PatientHistory)
                            {
                                <tr>
                                    <td>@h.AppointId</td>
                                    <td>@h.PatientName</td>
                                    <td>@h.Date?.ToString("MM/dd/yyyy")</td>
                                    <td>@h.Disease</td>
                                    <td>@h.Progress</td>
                                    <td>@h.Prescription</td>
                                    <td>
                                        <span class="badge @(h.BillStatus == "Paid" ? "bg-success" : "bg-warning")">
                                            @h.BillStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No previous history found.</div>
            }
        </div>
    </div>
</div>
