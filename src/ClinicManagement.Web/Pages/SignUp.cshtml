@page
@model ClinicManagement.Web.Pages.SignUpModel
@{
    ViewData["Title"] = "Login / Sign Up";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="text-center mb-4">
            <h1 class="display-4"><i class="fas fa-hospital-alt text-primary me-2"></i>Clinic Management System</h1>
            <p class="lead text-muted">Your health, our priority</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            <!-- Login Panel -->
            <div class="col-md-5">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="fas fa-sign-in-alt me-2"></i>Login</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="Login">
                            <div class="mb-3">
                                <label for="loginEmail" class="form-label">Email Address</label>
                                <input type="email" class="form-control" id="loginEmail" name="loginEmail"
                                       value="@Model.LoginEmail" placeholder="Enter your email" required />
                            </div>
                            <div class="mb-3">
                                <label for="loginPassword" class="form-label">Password</label>
                                <input type="password" class="form-control" id="loginPassword" name="loginPassword"
                                       placeholder="Enter your password" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-2 d-flex align-items-center justify-content-center">
                <div class="text-muted fw-bold">OR</div>
            </div>

            <!-- Sign Up Panel -->
            <div class="col-md-5">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0"><i class="fas fa-user-plus me-2"></i>Patient Sign Up</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="SignUp">
                            <div class="mb-2">
                                <label for="sName" class="form-label">Full Name</label>
                                <input type="text" class="form-control" id="sName" name="sName"
                                       value="@Model.SignUpName" placeholder="Enter your full name" required maxlength="30" />
                            </div>
                            <div class="mb-2">
                                <label for="sBirthDate" class="form-label">Birth Date</label>
                                <input type="date" class="form-control" id="sBirthDate" name="sBirthDate"
                                       value="@Model.SignUpBirthDate" required />
                            </div>
                            <div class="mb-2">
                                <label for="sEmail" class="form-label">Email Address</label>
                                <input type="email" class="form-control" id="sEmail" name="sEmail"
                                       value="@Model.SignUpEmail" placeholder="Enter your email" required maxlength="30" />
                            </div>
                            <div class="mb-2">
                                <label for="sPassword" class="form-label">Password</label>
                                <input type="password" class="form-control" id="sPassword" name="sPassword"
                                       placeholder="Create a password" required maxlength="20" />
                            </div>
                            <div class="mb-2">
                                <label for="sPhone" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="sPhone" name="sPhone"
                                       value="@Model.SignUpPhone" placeholder="Enter phone number" maxlength="15" />
                            </div>
                            <div class="mb-2">
                                <label for="sAddress" class="form-label">Address</label>
                                <input type="text" class="form-control" id="sAddress" name="sAddress"
                                       value="@Model.SignUpAddress" placeholder="Enter your address" maxlength="40" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Gender</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="Gender" id="genderM" value="M" checked />
                                        <label class="form-check-label" for="genderM">Male</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="Gender" id="genderF" value="F" />
                                        <label class="form-check-label" for="genderF">Female</label>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-user-plus me-2"></i>Sign Up
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
