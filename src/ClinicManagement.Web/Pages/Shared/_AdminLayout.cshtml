<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-danger">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Admin/AdminHome">
                <i class="fas fa-user-shield me-2"></i>Admin Panel
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-white" href="/Admin/AdminHome"><i class="fas fa-home me-1"></i>Home</a>
                <a class="nav-link text-white" href="/Admin/ManageClinic"><i class="fas fa-clinic-medical me-1"></i>Manage</a>
                <a class="nav-link text-white" href="/Admin/DoctorRegistrationForm"><i class="fas fa-user-md me-1"></i>Add Doctor</a>
                <a class="nav-link text-white" href="/Admin/AddStaff"><i class="fas fa-users me-1"></i>Add Staff</a>
                <a class="nav-link text-white" href="/Index"><i class="fas fa-sign-out-alt me-1"></i>Logout</a>
            </div>
        </div>
    </nav>
    <div class="container-fluid mt-3">
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
