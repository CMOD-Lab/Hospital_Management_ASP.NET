@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-file-invoice-dollar me-2"></i>Bills History</h2>
    <div class="card shadow">
        <div class="card-body">
            @if (Model.Bills.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Appointment ID</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bill in Model.Bills)
                            {
                                <tr>
                                    <td>@bill.AppointId</td>
                                    <td>@bill.DoctorName</td>
                                    <td>@bill.Date?.ToString("MM/dd/yyyy")</td>
                                    <td>$@bill.BillAmount?.ToString("N2")</td>
                                    <td>
                                        <span class="badge @(bill.BillStatus == "Paid" ? "bg-success" : "bg-danger")">
                                            @bill.BillStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No bills found.</div>
            }
        </div>
    </div>
</div>
