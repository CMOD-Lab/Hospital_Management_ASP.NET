@page
@model ClinicManagement.Web.Pages.Patient.BillsHistoryModel
@{
    ViewData["Title"] = "Bills History";
    Layout = "_PatientLayout";
}
<h2><i class="fas fa-file-invoice me-2"></i>Bills History</h2><hr />
<div class="card shadow">
    <div class="card-body">
        @if (Model.BillHistory.Count > 0)
        {
            <p class="lead">You have <strong>@Model.BillHistory.Count</strong> bill(s).</p>
            <table class="table table-striped">
                <thead class="table-dark"><tr><th>Bill ID</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var bill in Model.BillHistory.Bills)
                    {
                        <tr>
                            <td>@bill.BillId</td>
                            <td>$@bill.Amount.ToString("N2")</td>
                            <td>@(bill.IsPaid ? "Paid" : "Unpaid")</td>
                            <td>@bill.BillDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="alert alert-info">No bills found.</div> }
    </div>
</div>
