@page
@model ClinicManagement.Web.Pages.Patient.TreatmentHistoryModel
@{
    ViewData["Title"] = "Treatment History";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-notes-medical me-2"></i>Treatment History</h2>
    <div class="card shadow">
        <div class="card-body">
            @if (Model.TreatmentHistory.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th><th>Doctor</th><th>Date</th><th>Disease</th><th>Progress</th><th>Prescription</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.TreatmentHistory)
                            {
                                <tr>
                                    <td>@t.AppointId</td>
                                    <td>@t.DoctorName</td>
                                    <td>@t.Date?.ToString("MM/dd/yyyy")</td>
                                    <td>@t.Disease</td>
                                    <td>@t.Progress</td>
                                    <td>@t.Prescription</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No treatment history found.</div>
            }
        </div>
    </div>
</div>
