@page
@model ClinicManagement.Web.Pages.Patient.ViewDoctorsModel
@{
    ViewData["Title"] = "View Doctors";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-user-md me-2"></i>View Doctors</h2>

    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Select Department</h5>
        </div>
        <div class="card-body">
            <form method="get">
                <div class="row align-items-end">
                    <div class="col-md-6">
                        <label for="deptName" class="form-label">Department</label>
                        <select class="form-select" id="deptName" name="deptName">
                            <option value="">-- All Departments --</option>
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.DeptName" selected="@(Model.SelectedDept == dept.DeptName)">
                                    @dept.DeptName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-2"></i>Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Doctors.Any())
    {
        <div class="row">
            @foreach (var doctor in Model.Doctors)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow h-100">
                        <div class="card-body text-center">
                            <i class="fas fa-user-md fa-4x text-primary mb-3"></i>
                            <h5 class="card-title">@doctor.Name</h5>
                            <p class="text-muted">@doctor.Department</p>
                            <a href="/Patient/DoctorProfile?doctorId=@doctor.DoctorId" class="btn btn-outline-primary btn-sm me-2">
                                <i class="fas fa-eye me-1"></i>View Profile
                            </a>
                            <a href="/Patient/AppointmentTaker?doctorId=@doctor.DoctorId" class="btn btn-success btn-sm">
                                <i class="fas fa-calendar-plus me-1"></i>Book Appointment
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.SelectedDept))
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No doctors found for the selected department.
        </div>
    }
</div>
