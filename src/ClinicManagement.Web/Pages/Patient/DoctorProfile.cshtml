@page
@model ClinicManagement.Web.Pages.Patient.DoctorProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-user-md me-2"></i>Doctor Profile</h2>

    @if (Model.DoctorProfile != null)
    {
        <div class="card shadow">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <i class="fas fa-user-md fa-8x text-primary mb-3"></i>
                        <h4>@Model.DoctorProfile.Name</h4>
                        <p class="text-muted">@Model.DoctorProfile.Specialization</p>
                        <a href="/Patient/AppointmentTaker?doctorId=@Model.DoctorProfile.DoctorId" class="btn btn-success">
                            <i class="fas fa-calendar-plus me-2"></i>Book Appointment
                        </a>
                    </div>
                    <div class="col-md-9">
                        <table class="table table-borderless">
                            <tr>
                                <th width="35%"><i class="fas fa-phone me-2 text-muted"></i>Phone</th>
                                <td>@Model.DoctorProfile.Phone</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-venus-mars me-2 text-muted"></i>Gender</th>
                                <td>@(Model.DoctorProfile.Gender == "M" ? "Male" : "Female")</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-dollar-sign me-2 text-muted"></i>Charges Per Visit</th>
                                <td>$@Model.DoctorProfile.ChargesPerVisit.ToString("N2")</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-star me-2 text-muted"></i>Repute Index</th>
                                <td>@Model.DoctorProfile.ReputeIndex.ToString("N2")</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-users me-2 text-muted"></i>Patients Treated</th>
                                <td>@Model.DoctorProfile.PatientsTreated</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-graduation-cap me-2 text-muted"></i>Qualification</th>
                                <td>@Model.DoctorProfile.Qualification</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-briefcase me-2 text-muted"></i>Work Experience</th>
                                <td>@Model.DoctorProfile.WorkExperience years</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-birthday-cake me-2 text-muted"></i>Age</th>
                                <td>@Model.DoctorProfile.Age years</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>Doctor profile not found.
        </div>
    }

    <div class="mt-3">
        <a href="/Patient/ViewDoctors" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Doctors
        </a>
    </div>
</div>
