@page
@model ClinicManagement.Web.Pages.Patient.PatientHomeModel
@{
    ViewData["Title"] = "Patient Home";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-user-injured me-2"></i>Patient Dashboard</h2>

    @if (Model.PatientInfo != null)
    {
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="fas fa-id-card me-2"></i>Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tr>
                                <th width="40%"><i class="fas fa-user me-2 text-muted"></i>Name</th>
                                <td>@Model.PatientInfo.Name</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-phone me-2 text-muted"></i>Phone</th>
                                <td>@Model.PatientInfo.Phone</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-birthday-cake me-2 text-muted"></i>Birth Date</th>
                                <td>@Model.PatientInfo.BirthDate</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-calendar me-2 text-muted"></i>Age</th>
                                <td>@Model.PatientInfo.Age years</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-map-marker-alt me-2 text-muted"></i>Address</th>
                                <td>@Model.PatientInfo.Address</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-venus-mars me-2 text-muted"></i>Gender</th>
                                <td>@(Model.PatientInfo.Gender == "M" ? "Male" : "Female")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row g-3">
                    <div class="col-6">
                        <a href="/Patient/ViewDoctors" class="text-decoration-none">
                            <div class="card bg-primary text-white text-center p-3 shadow h-100">
                                <i class="fas fa-user-md fa-3x mb-2"></i>
                                <h6>View Doctors</h6>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Patient/CurrentAppointment" class="text-decoration-none">
                            <div class="card bg-success text-white text-center p-3 shadow h-100">
                                <i class="fas fa-calendar-check fa-3x mb-2"></i>
                                <h6>Current Appointment</h6>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Patient/BillsHistory" class="text-decoration-none">
                            <div class="card bg-warning text-white text-center p-3 shadow h-100">
                                <i class="fas fa-file-invoice-dollar fa-3x mb-2"></i>
                                <h6>Bills History</h6>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Patient/TreatmentHistory" class="text-decoration-none">
                            <div class="card bg-info text-white text-center p-3 shadow h-100">
                                <i class="fas fa-notes-medical fa-3x mb-2"></i>
                                <h6>Treatment History</h6>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Patient/PatientNotifications" class="text-decoration-none">
                            <div class="card bg-secondary text-white text-center p-3 shadow h-100">
                                <i class="fas fa-bell fa-3x mb-2"></i>
                                <h6>Notifications</h6>
                            </div>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/Patient/PatientFeedback" class="text-decoration-none">
                            <div class="card bg-danger text-white text-center p-3 shadow h-100">
                                <i class="fas fa-star fa-3x mb-2"></i>
                                <h6>Feedback</h6>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>Unable to load patient information. Please try again.
        </div>
    }
</div>
