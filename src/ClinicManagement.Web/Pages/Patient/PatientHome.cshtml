@page
@model ClinicManagement.Web.Pages.Patient.PatientHomeModel
@{
    ViewData["Title"] = "Patient Home";
    Layout = "_PatientLayout";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-user-injured me-2"></i>Patient Profile</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow text-center">
            <div class="card-body">
                <i class="fas fa-user-circle fa-5x text-info mb-3"></i>
                <h4>@Model.PatientInfo.Name</h4>
                <p class="text-muted">@Model.PatientInfo.Gender</p>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Patient Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Name:</strong> @Model.PatientInfo.Name</p>
                        <p><strong>Phone:</strong> @Model.PatientInfo.Phone</p>
                        <p><strong>Birth Date:</strong> @Model.PatientInfo.BirthDate</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Age:</strong> @Model.PatientInfo.Age</p>
                        <p><strong>Address:</strong> @Model.PatientInfo.Address</p>
                        <p><strong>Gender:</strong> @Model.PatientInfo.Gender</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
