@page
@model ClinicManagement.Web.Pages.Patient.AppointmentRequestSentModel
@{
    ViewData["Title"] = "Appointment Request Sent";
    Layout = "_PatientLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow text-center">
            <div class="card-body py-5">
                @if (Model.RequestModel.Success)
                {
                    <i class="fas fa-check-circle fa-5x text-success mb-3"></i>
                    <h3 class="text-success">Appointment Request Sent!</h3>
                    <p class="lead">@Model.RequestModel.Message</p>
                }
                else
                {
                    <i class="fas fa-times-circle fa-5x text-danger mb-3"></i>
                    <h3 class="text-danger">Request Failed</h3>
                    <p class="lead">@Model.RequestModel.Message</p>
                }
                <a href="/Patient/PatientHome" class="btn btn-primary mt-3">
                    <i class="fas fa-home me-2"></i>Go to Home
                </a>
            </div>
        </div>
    </div>
</div>
