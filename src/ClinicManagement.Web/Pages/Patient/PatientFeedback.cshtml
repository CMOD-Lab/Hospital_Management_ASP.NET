@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
    Layout = "_PatientLayout";
}
<h2><i class="fas fa-comment me-2"></i>Patient Feedback</h2><hr />
<div class="card shadow">
    <div class="card-body text-center py-5">
        @if (Model.FeedbackInfo.FeedbackSubmitted)
        {
            <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
            <h4 class="text-success">Feedback submitted successfully!</h4>
        }
        else if (Model.FeedbackInfo.HasPendingFeedback)
        {
            <i class="fas fa-comment-dots fa-4x text-warning mb-3"></i>
            <h4>Pending Feedback</h4>
            <p><strong>Doctor:</strong> @Model.FeedbackInfo.DoctorName</p>
            <p><strong>Timings:</strong> @Model.FeedbackInfo.Timings</p>
            <form method="post">
                <input type="hidden" name="appointmentId" value="@Model.FeedbackInfo.AppointmentId" />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-thumbs-up me-2"></i>Submit Feedback
                </button>
            </form>
        }
        else
        {
            <i class="fas fa-comment-slash fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No pending feedback at this time.</h4>
        }
    </div>
</div>
