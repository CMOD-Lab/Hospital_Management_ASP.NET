@page
@model ClinicManagement.Web.Pages.Patient.PatientFeedbackModel
@{
    ViewData["Title"] = "Patient Feedback";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-star me-2"></i>Patient Feedback</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-info") alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.PendingFeedback != null)
    {
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="fas fa-star me-2"></i>Pending Feedback</h5>
            </div>
            <div class="card-body">
                <p><strong>Doctor:</strong> @Model.PendingFeedback.DoctorName</p>
                <p><strong>Appointment Time:</strong> @Model.PendingFeedback.Timings</p>
                <form method="post">
                    <input type="hidden" name="appointmentId" value="@Model.PendingFeedback.AppointmentId" />
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-thumbs-up me-2"></i>Submit Feedback
                    </button>
                </form>
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No pending feedback at this time.</div>
    }
</div>
