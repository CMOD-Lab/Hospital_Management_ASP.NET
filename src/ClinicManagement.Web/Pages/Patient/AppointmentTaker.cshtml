@page
@model ClinicManagement.Web.Pages.Patient.AppointmentTakerModel
@{
    ViewData["Title"] = "Take Appointment";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-calendar-plus me-2"></i>Book Appointment</h2>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.FreeSlots.Any())
    {
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Available Slots for Dr. @Model.DoctorName</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="doctorId" value="@Model.DoctorId" />
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Select</th>
                                    <th>Date & Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in Model.FreeSlots)
                                {
                                    <tr>
                                        <td>
                                            <input type="radio" name="freeSlot" value="@slot.SlotId" required />
                                        </td>
                                        <td>@slot.SlotTime</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-calendar-check me-2"></i>Book Selected Slot
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No available slots for this doctor at the moment.
        </div>
    }

    <div class="mt-3">
        <a href="/Patient/ViewDoctors" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Doctors
        </a>
    </div>
</div>
