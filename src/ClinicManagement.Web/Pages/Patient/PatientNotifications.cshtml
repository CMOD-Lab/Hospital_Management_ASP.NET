@page
@model ClinicManagement.Web.Pages.Patient.PatientNotificationsModel
@{
    ViewData["Title"] = "Notifications";
    Layout = "_PatientLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-bell me-2"></i>Notifications</h2>
    @if (Model.Notification != null)
    {
        <div class="card shadow border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Appointment Approved!</h5>
            </div>
            <div class="card-body">
                <p><strong>Doctor:</strong> @Model.Notification.DoctorName</p>
                <p><strong>Time:</strong> @Model.Notification.Timings</p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>No new notifications.</div>
    }
</div>
