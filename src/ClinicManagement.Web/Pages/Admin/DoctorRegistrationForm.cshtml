@page
@model ClinicManagement.Web.Pages.Admin.DoctorRegistrationFormModel
@{
    ViewData["Title"] = "Doctor Registration";
    Layout = "_AdminLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-user-md me-2"></i>Doctor Registration</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Name" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Name" name="Name" maxlength="30" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="Email" name="Email" maxlength="30" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="Password" name="Password" maxlength="20" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="BirthDate" class="form-label">Birth Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="BirthDate" name="BirthDate" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Department" class="form-label">Department <span class="text-danger">*</span></label>
                        <select class="form-select" id="Department" name="DeptNo" required>
                            <option value="0">-- Select Department --</option>
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.DeptNo">@dept.DeptName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Phone" class="form-label">Phone</label>
                        <input type="tel" class="form-control" id="Phone" name="Phone" maxlength="15" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Gender <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Gender" value="M" id="genderM" checked />
                                <label class="form-check-label" for="genderM">Male</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Gender" value="F" id="genderF" />
                                <label class="form-check-label" for="genderF">Female</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Address" class="form-label">Address</label>
                        <input type="text" class="form-control" id="Address" name="Address" maxlength="40" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="Exp" class="form-label">Experience (years)</label>
                        <input type="number" class="form-control" id="Exp" name="Experience" min="0" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="Salary" class="form-label">Monthly Salary</label>
                        <input type="number" class="form-control" id="Salary" name="Salary" min="0" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="Charges" class="form-label">Charges Per Visit <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="Charges" name="ChargesPerVisit" min="0" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Specialization" class="form-label">Specialization</label>
                        <input type="text" class="form-control" id="Specialization" name="Specialization" maxlength="100" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Qualification" class="form-label">Qualification <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Qualification" name="Qualification" maxlength="100" required />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Register Doctor
                    </button>
                    <a href="/Admin/AdminHome" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
