@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Home";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Doctors</h6>
                            <h2 class="mb-0">@Model.TotalDoctors</h2>
                        </div>
                        <i class="fas fa-user-md fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Patients</h6>
                            <h2 class="mb-0">@Model.TotalPatients</h2>
                        </div>
                        <i class="fas fa-user-injured fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-white shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Income</h6>
                            <h2 class="mb-0">$@Model.TotalIncome.ToString("N2")</h2>
                        </div>
                        <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Departments Table -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-building me-2"></i>Departments</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th>Doctors</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.Departments)
                                {
                                    <tr>
                                        <td>@dept.DeptName</td>
                                        <td>@dept.DoctorCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Appointments -->
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Recent Appointments</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.Appointments)
                                {
                                    <tr>
                                        <td>@appt.PatientName</td>
                                        <td>@appt.DoctorName</td>
                                        <td>@appt.Date?.ToString("MM/dd/yyyy")</td>
                                        <td>
                                            <span class="badge @(appt.Status == "1" ? "bg-success" : appt.Status == "2" ? "bg-warning" : appt.Status == "3" ? "bg-info" : "bg-danger")">
                                                @(appt.Status == "1" ? "Approved" : appt.Status == "2" ? "Pending" : appt.Status == "3" ? "Completed" : "Rejected")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
