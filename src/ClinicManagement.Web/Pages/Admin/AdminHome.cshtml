@page
@model ClinicManagement.Web.Pages.Admin.AdminHomeModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h2>
        <hr />
    </div>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Doctors</h6>
                        <h2 class="mb-0">@Model.Dashboard.TotalDoctors</h2>
                    </div>
                    <i class="fas fa-user-md fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Patients</h6>
                        <h2 class="mb-0">@Model.Dashboard.TotalPatients</h2>
                    </div>
                    <i class="fas fa-user-injured fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Income</h6>
                        <h2 class="mb-0">$@Model.Dashboard.TotalIncome.ToString("N2")</h2>
                    </div>
                    <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Department Stats -->
<div class="row">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-building me-2"></i>Department Overview</h5>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.DepartmentStats.Any())
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Department</th>
                                <th>Doctors</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.Dashboard.DepartmentStats)
                            {
                                <tr>
                                    <td>@dept.DeptName</td>
                                    <td>@dept.DoctorCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No department data available.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/Admin/DoctorRegistrationForm" class="btn btn-outline-primary">
                        <i class="fas fa-user-md me-2"></i>Register New Doctor
                    </a>
                    <a href="/Admin/AddStaff" class="btn btn-outline-success">
                        <i class="fas fa-users me-2"></i>Add Staff Member
                    </a>
                    <a href="/Admin/ManageClinic" class="btn btn-outline-info">
                        <i class="fas fa-clinic-medical me-2"></i>Manage Clinic
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
