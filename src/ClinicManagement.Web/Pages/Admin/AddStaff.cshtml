@page
@model ClinicManagement.Web.Pages.Admin.AddStaffModel
@{
    ViewData["Title"] = "Add Staff";
    Layout = "_AdminLayout";
}

<div class="container">
    <h2 class="mb-4"><i class="fas fa-users me-2"></i>Add Staff Member</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Name" class="form-label">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Name" name="Name" maxlength="30" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="BirthDate" class="form-label">Birth Date</label>
                        <input type="date" class="form-control" id="BirthDate" name="BirthDate" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Phone" class="form-label">Phone</label>
                        <input type="tel" class="form-control" id="Phone" name="Phone" maxlength="15" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Gender <span class="text-danger">*</span></label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Gender" value="M" id="genderM" checked />
                                <label class="form-check-label" for="genderM">Male</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Gender" value="F" id="genderF" />
                                <label class="form-check-label" for="genderF">Female</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Address" class="form-label">Address</label>
                        <input type="text" class="form-control" id="Address" name="Address" maxlength="50" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Salary" class="form-label">Salary</label>
                        <input type="number" class="form-control" id="Salary" name="Salary" min="0" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Qualification" class="form-label">Qualification</label>
                        <input type="text" class="form-control" id="Qualification" name="Qualification" maxlength="50" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="Designation" class="form-label">Designation <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Designation" name="Designation" maxlength="15" required />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Add Staff
                    </button>
                    <a href="/Admin/AdminHome" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
