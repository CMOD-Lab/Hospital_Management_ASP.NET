@page
@model ClinicManagement.Web.Pages.Admin.ManageClinicModel
@{
    ViewData["Title"] = "Manage Clinic";
    Layout = "_AdminLayout";
}

<div class="row mb-3">
    <div class="col-12">
        <h2><i class="fas fa-clinic-medical me-2"></i>Manage Clinic</h2>
        <hr />
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ClinicModel.Message))
{
    <div class="alert alert-info">@Model.ClinicModel.Message</div>
}

<!-- Search and Filter -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="category" value="DOCTOR"
                                   @(Model.ClinicModel.Category == "DOCTOR" ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label">Doctor</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="category" value="PATIENT"
                                   @(Model.ClinicModel.Category == "PATIENT" ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label">Patient</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="category" value="OTHERSTAFF"
                                   @(Model.ClinicModel.Category == "OTHERSTAFF" ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label">Staff</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Search</label>
                    <input type="text" name="searchQuery" value="@Model.ClinicModel.SearchQuery" class="form-control" placeholder="Search by name..." />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results Table -->
<div class="card shadow">
    <div class="card-body">
        @if (Model.ClinicModel.Category == "DOCTOR")
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.ClinicModel.Doctors)
                    {
                        <tr>
                            <td>@doc.DoctorId</td>
                            <td>@doc.Name</td>
                            <td>@doc.DepartmentName</td>
                            <td>
                                <a href="/Admin/ManageClinic?action=delete&id=@doc.DoctorId&category=DOCTOR"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this doctor?')">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                                <a href="/Admin/ManageClinic?action=view&id=@doc.DoctorId&category=DOCTOR"
                                   class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (Model.ClinicModel.Category == "PATIENT")
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.ClinicModel.Patients)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.Name</td>
                            <td>@patient.Phone</td>
                            <td>
                                <a href="/Admin/ManageClinic?action=view&id=@patient.PatientId&category=PATIENT"
                                   class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.ClinicModel.Staff)
                    {
                        <tr>
                            <td>@staff.StaffId</td>
                            <td>@staff.Name</td>
                            <td>@staff.Designation</td>
                            <td>
                                <a href="/Admin/ManageClinic?action=delete&id=@staff.StaffId&category=OTHERSTAFF"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this staff member?')">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (!string.IsNullOrEmpty(Model.ClinicModel.SelectedDetails))
        {
            <div class="card mt-3 border-info">
                <div class="card-header bg-info text-white">Details</div>
                <div class="card-body">
                    @Html.Raw(Model.ClinicModel.SelectedDetails)
                </div>
            </div>
        }
    </div>
</div>
